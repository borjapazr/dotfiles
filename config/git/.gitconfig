[user]
	name = Borja Paz Rodríguez
	email = borjapazr@gmail.com
	signingkey = 5DBA4F4512483370

# Every repository under ~/Projects/ is work-related.
[includeIf "gitdir:~/Projects/"]
	path = .gitconfig.inditex

# Worktrees created by aicontext/aidevtracker point their working tree under
# ~/Projects but their real .git dir lives under ~/.aicontext/global-repos/,
# which includeIf "gitdir:" matches against (not the worktree path).
[includeIf "gitdir:~/.aicontext/"]
	path = .gitconfig.inditex

[core]
	excludesfile = ~/.gitignore_global
	attributesfile = ~/.gitattributes
	editor = vim
	autocrlf = input
	trustctime = false
	# APFS stores accented filenames decomposed; false makes them look modified.
	precomposeunicode = true
	ignorecase = false
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	features = line-numbers decorations
	whitespace-error-style = 22 reverse
	navigate = true

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none

[fetch]
	prune = true
	fsckobjects = true

[transfer]
	fsckobjects = true

[receive]
	fsckObjects = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[apply]
	whitespace = fix

[diff]
	tool = vimdiff
	indentHeuristic = true
	algorithm = histogram
	colorMoved = default

# Hunk headers name the JSON key being changed instead of a bare brace.
[diff "json"]
	xfuncname = "^ *\"[a-zA-Z_-]+\":"

# Diff image metadata instead of reporting "binary files differ".
[diff "exif"]
	textconv = exiftool

[help]
	autocorrect = prompt

[difftool]
	prompt = false

[color]
	branch = auto
	diff = auto
	interactive = auto
	pager = true
	status = auto
	ui = true

[color "diff"]
	meta = yellow bold
	commit = green bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse

[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = "red bold 52"
	newNormal = green bold
	newHighlight = "green bold 22"

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[gpg]
	program = gpg

[pull]
	rebase = true

[rebase]
	autosquash = true
	autostash = true
	updateRefs = true

[merge]
	conflictstyle = zdiff3

# Remember how a conflict was resolved and replay it next time.
[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[alias]
	nah = "!f(){ git reset --hard; git clean -df; if [ -d ".git/rebase-apply" ] || [ -d ".git/rebase-merge" ]; then git rebase --abort; fi; }; f"
	undo = "reset HEAD~1 --mixed"

[init]
	defaultBranch = main
