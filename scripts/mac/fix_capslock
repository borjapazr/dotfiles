#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/scripts/core/_main.sh"

##? Remove the Caps Lock key delay
##?
##? Usage:
##?   fix_capslock
##?
##? hidutil property doesn't persist across reboots/logins — re-run this
##? after a restart to reapply it.
docs::parse "$@"

hidutil property --set '{"CapsLockDelayOverride":0}' >/dev/null

log::success "Done!"
