#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/commands/core/_main.sh"

##? Benchmark zsh interactive startup time
##?
##? Usage:
##?   benchmark
##?
##? Measures `zsh -i -c true` with hyperfine. For a per-function breakdown of
##? where startup time goes, run: ZSH_PROFILE=1 zsh -i -c exit
docs::parse "$@"

if ! platform::command_exists hyperfine; then
  log::error "hyperfine is required for this benchmark (brew install hyperfine)"
  exit 1
fi

log::info "⏱  Benchmarking zsh interactive startup (10 warmup + 30 runs)"
hyperfine --warmup 10 --runs 30 'zsh -i -c true'

log::info "💡 For a per-function breakdown: ZSH_PROFILE=1 zsh -i -c exit"
