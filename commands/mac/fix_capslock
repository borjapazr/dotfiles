#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/commands/core/_main.sh"

##? Remove the Caps Lock key delay
##?
##? Usage:
##?   fix_capslock
##?
##? hidutil property resets at login; a LaunchAgent reapplies it automatically.
docs::parse "$@"

hidutil property --set '{"CapsLockDelayOverride":0}' >/dev/null

log::success "Done!"
